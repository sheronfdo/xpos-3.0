	<parameter name="saleInvoice" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT sale.Id, sale.Date, sale.Time, customer.Name, sale.TotalRetailPrice, sale.DiscountByItems, sale.DiscountByTotal, sale.FinalTotal, sale.Pay, product.Description, solditem.RetailPrice, solditem.Quantity, solditem.Total, solditem.DiscountForItem, solditem.Balance FROM (((sale JOIN customer ON customer.Id=sale.Customer_Id)JOIN solditem on sale.Id=solditem.Sale_Id)JOIN product on product.Id=solditem.Product_Id) WHERE sale.Id = $P{saleInvoice}]]>
	</queryString>
