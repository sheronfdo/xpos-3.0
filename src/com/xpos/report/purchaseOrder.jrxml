	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="POID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT purchaseorder.Id, supplier.Name as suppliername, purchaseorder.Date, purchaseorder.SubTotal, purchaseorder.Discount, purchaseorder.FinalTotal, purchaseorderitem.ItemPrice, product.Description, purchaseorderitem.Quantity, purchaseorderitem.TotalPrice, supplier.Address, supplier.TelephoneNo, supplier.RegisterNo FROM ((((`purchaseorder` JOIN supplier ON purchaseorder.Supplier_Id=supplier.Id) join purchaseorderitem ON purchaseorder.Id=purchaseorderitem.PurchaseOrder_Id)JOIN product ON product.Id=purchaseorderitem.Product_Id)) WHERE purchaseorder.Id =  $P{POID}]]>
	</queryString>
