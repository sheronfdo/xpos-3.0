<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reqForQuate" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="97b4670e-c5e3-4cd3-bcf7-520487a72bb0">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="xpos_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="reqforquateid" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT reqforquate.Id,
 reqforquate.Date,
 reqforquate.Supplier_Id,
 supplier.Name,
 supplier.Address,
 supplier.TelephoneNo,
 supplier.RegisterNo,
 product.Description,
 reqforquateitem.Quantity,
 ifnull((SELECT supplierproduct.ItemCode
 FROM supplierproduct
 WHERE supplierproduct.Supplier_Id=reqforquate.Supplier_Id AND supplierproduct.Product_Id=reqforquateitem.Product_Id),("")) as itemcode 
 FROM (((reqforquate
 JOIN reqforquateitem ON reqforquate.Id=reqforquateitem.ReqForQuate_Id)
 JOIN product ON reqforquateitem.Product_Id=product.Id)
 JOIN supplier ON reqforquate.Supplier_Id=supplier.Id)
 WHERE reqforquate.Id=$P{reqforquateid} ]]>
	</queryString>
