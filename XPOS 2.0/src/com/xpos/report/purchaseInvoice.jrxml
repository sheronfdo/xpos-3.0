	<parameter name="purchaseId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT purchase.Id, purchase.PurchaseOrder_Id, purchase.Supplier_Id, purchase.PurchaseDate, purchase.Total, purchase.Discount, purchase.Balance, purchaseitem.Product_Id, purchaseitem.PurchasePrice, purchaseitem.Quantity, purchaseitem.TotalPrice, product.Description, supplier.Name, supplier.Address, supplier.TelephoneNo, supplier.RegisterNo from (((purchase JOIN purchaseitem ON purchase.Id=purchaseitem.Purchase_Id) JOIN product ON purchaseitem.Product_Id=product.Id)join supplier on purchase.Supplier_Id=supplier.Id) where purchase.Id=$P{purchaseId}]]>
	</queryString>
