	<parameter name="SaleId" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	xpos_db_2.solditem.`sale_id`,
	xpos_db_2.solditem.`Product_Id`,
	xpos_db_2.solditem.`RetailPrice`,
	xpos_db_2.solditem.`Quantity`,
	xpos_db_2.solditem.`Total`,
	xpos_db_2.solditem.`DiscountForItem`,
	xpos_db_2.solditem.`Balance`,
	xpos_db_2.sale.`Date`,
	xpos_db_2.sale.`Time`,
	xpos_db_2.sale.`Customer_Id`,
	xpos_db_2.sale.`TotalRetailPrice`,
	xpos_db_2.sale.`DiscountByItems`,
	xpos_db_2.sale.`DiscountByTotal`,
	xpos_db_2.sale.`FinalTotal`,
	xpos_db_2.sale.`Pay`,
	xpos_db_2.product.`Description`,
	xpos_db_2.customer.`Name`
FROM xpos_db_2.solditem
	INNER JOIN xpos_db_2.sale ON 
	 xpos_db_2.sale.`Id` = xpos_db_2.solditem.`Sale_Id` 
	INNER JOIN xpos_db_2.product ON 
	 xpos_db_2.solditem.`Product_Id` = xpos_db_2.product.`Id` 
	INNER JOIN xpos_db_2.customer ON 
	 xpos_db_2.customer.`Id` = xpos_db_2.sale.`Customer_Id` 
WHERE 
	 xpos_db_2.solditem.`Sale_Id` =  $P{SaleId}]]>
	</queryString>
