<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="returnInvoice" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="456dfd92-c6e1-4ea2-a7b3-d9ddbdc521e1">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="xpos_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="returnIdNum" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT `return`.`Id`, `return`.`Sale_Id`, `return`.`Date`, `return`.`RefundAmount`, product.Description, CASE WHEN `returnitem`.`type`='R' THEN 'Replace' WHEN `returnitem`.`type`='C' THEN 'Cash Refund' END as Type, CASE WHEN `returnitem`.`cond`='D' THEN 'Damage' WHEN `returnitem`.`cond`='G' THEN 'Good' END as Cond, `returnitem`.`Quantity`, `returnitem`.`ReturnPrice` FROM ((`returnitem` JOIN `return` ON `return`.`Id`= `returnitem`.`Return_Id`)JOIN product ON `returnitem`.Product_Id=product.Id) WHERE `return`.`Id`=$P{returnIdNum}]]>
	</queryString>
